{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "local": {
      "projectType": "application",
      "root": "projects/local",
      "sourceRoot": "projects/local/src",
      "prefix": "party",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/local",
            "browser": "projects/local/src/main.ts",
            "tsConfig": "projects/local/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/local/public"
              }
            ],
            "styles": [
              "projects/local/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kB",
                  "maximumError": "450kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "demo": {
              "outputPath": {
                "base": "dist/demo-local/classic",
                "browser": ""
              },
              "fileReplacements": [
                {
                  "replace": "projects/party-demo/src/switch.ts",
                  "with": "projects/party-demo/src/switch.demo.ts"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/classic/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "local:build:production"
            },
            "development": {
              "buildTarget": "local:build:development"
            },
            "demo": {
              "buildTarget": "local:build:development,demo"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          }
        }
      }
    },
    "companion": {
      "projectType": "application",
      "root": "projects/companion",
      "sourceRoot": "projects/companion/src",
      "prefix": "party",
      "architect": {
